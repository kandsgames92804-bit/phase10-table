rules_version = '2';
// Paste into Firebase console -> Firestore Database -> Rules, then Publish.
// Only signed-in (anonymous) app users can read or write, only inside a table
// (rooms/{code}/...), and documents are size-limited. The 6-character table
// code works like a password for the table, so share it only with your group.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{room}/{coll}/{doc} {
      allow read: if request.auth != null
        && coll in ['meta', 'players', 'games', 'entries'];
      allow create, update: if request.auth != null
        && coll in ['meta', 'players', 'games', 'entries']
        && room.size() == 6
        && request.resource.data.size() < 40
        && (coll != 'meta' || !exists(/databases/$(database)/documents/rooms/$(room)/meta/room));
      allow delete: if request.auth != null && coll in ['games', 'entries'];
    }
  }
}
